# Python
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
.env

# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# Native build outputs
cmake-build-*/

# Generated ML data and model outputs
ml/data/raw/*
ml/data/processed/*
ml/data/splits/*
backend/model_artifacts/*

# Keep directory placeholders
!**/.gitkeep

# IDE and machine-local files
.idea/
.vscode/
*.iml
flutter_log.txt
/package-lock.json

# Signing keys are never committed
*.keystore
*.jks

# Generated by `flutter pub get` / `flutter build ios` (contain local paths)
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh
frontend/ios/Flutter/ephemeral/

# Gradle caches
.gradle/

# Offline map archives (~170 MB). Regenerate with
# tools/offline_maps/build_offline_maps.py; the app runs without them.
frontend/assets/maps/packs/*.pmtiles

# Datasets and local tooling
IO-VNBD_DATASET/
.claude/

# APK distribution builds
apks/
*.apk

# Legacy archive directory
SIH_DEAD_RECKONING-main/
