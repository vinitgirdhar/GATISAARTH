# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# Native build outputs
cmake-build-*/

# Generated ML data and model outputs
ml/data/raw/*
ml/data/processed/*
ml/data/splits/*
